# Aucune donnée, aucune sortie, aucun secret dans le dépôt
*.sqlite
*.sqlite-*
*.db
*.xlsx
*.xls
*.csv
!jeu_essai/donnees/*.csv
*.json
!api/**/schemas/*.json
!pipeline/tests/attendu_*.json
*.parquet
*.jsonl
publication/
jeu_essai/sortie/

# Pages générées (les modèles et les pages du front sont versionnés)
*.html
!pipeline/*_modele.html
!front/*.html
!.claude/skills/**/*.html

# Secrets
.env
.env.*
!deploiement/.env.exemple
*.pem
*.key

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Outils de qualité
.coverage
.coverage.*
mutants/
.mutmut-cache
html/


# --- Étape 1 : cadre de travail ---
# Réglages personnels, copies de travail, imports non contrôlés
.claude/settings.local.json
.claude/worktrees/
CLAUDE.local.md
.verif/
import/
# Caches d'outils
.ruff_cache/
.mypy_cache/
.hypothesis/
# Pièces et images de pièces : jamais dans le dépôt
*.pdf
*.jpg
*.jpeg
*.png
*.heic
*.tif
*.tiff
# Réautorisés : réglages partagés de Claude Code, fichiers des skills
!.claude/settings.json
!.claude/skills/**/*.json
