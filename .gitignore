# Aucune donnée, aucune sortie, aucun secret dans le dépôt
*.sqlite
*.sqlite-*
*.db
*.xlsx
*.xls
*.csv
!jeu_essai/donnees/*.csv
*.json
!api/**/schemas/*.json
*.parquet
*.jsonl
publication/
jeu_essai/sortie/

# Pages générées (les modèles et les pages du front sont versionnés)
*.html
!pipeline/*_modele.html
!front/*.html

# Secrets
.env
.env.*
!deploiement/.env.exemple
*.pem
*.key

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Outils de qualité
.coverage
.coverage.*
mutants/
.mutmut-cache
html/
